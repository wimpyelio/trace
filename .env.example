# Copy to .env. Values here are safe placeholders; never commit real credentials.
TRACE_GRAPH_BACKEND=memory
TRACE_LLM_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# FalkorDB local Docker defaults. For cloud, set FALKORDB_URL or the host/port/user/password.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=trace
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false
FALKORDB_URL=

# Only required to execute confirmed external actions.
SLACK_WEBHOOK_URL=
GITHUB_TOKEN=
GITHUB_REPO=owner/repository

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
